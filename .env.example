# Copiar a .env para desarrollo local y cargar en Vercel para producción.
# .env está en .gitignore: nunca subir claves al repo.

# --- Panel de administración ---
# Clave de acceso al panel.
ADMIN_CLAVE=
# Secreto para firmar la cookie de sesión. Generar uno largo y aleatorio:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_SECRETO=

# --- Google ---
# ID de medición de GA4. Se crea en analytics.google.com.
PUBLIC_GA_ID=
# Token de la etiqueta de verificación de Search Console (solo el content=).
PUBLIC_GSC_VERIFICACION=

# --- Catálogo (API de kafe.agency) ---
# URL completa del catálogo, token incluido. La da el proveedor.
#   https://auto.kafe.agency/api/public/catalogo/kafe_cat_XXXXXXXX
# SIN el prefijo PUBLIC_: el token va en la URL, así que si llegara al
# navegador cualquiera podría leer el catálogo entero. Solo la usa el
# servidor, en /api/catalogo. Si se filtra, pedir que la roten.
CATALOGO_URL=

# --- Almacenamiento (Vercel Blob) ---
# Guarda la curaduría del panel: qué productos van en cada vitrina.
# Se crea en Vercel: proyecto → Storage → Create Database → Blob (privado).
# IMPORTANTE: marcar "Add a read-write token env var to this connection".
# Sin esa casilla solo se generan credenciales OIDC, que funcionan dentro de
# Vercel pero no sirven para desarrollo local.
# Después:  npx vercel env pull
# Sin esto el panel guarda solo en memoria y en producción no guardaría nada.
BLOB_READ_WRITE_TOKEN=
