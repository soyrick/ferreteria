---
/* Marco común de las cuatro pantallas del panel. */
import '../styles/styles.css';
import '../styles/admin.css';

const { titulo } = Astro.props;
const actual = Astro.url.pathname.replace(/\/$/, '') || '/admin';

const SECCIONES = [
  { ruta: '/admin',            nombre: 'Estadísticas',   icono: 'i-etiqueta' },
  { ruta: '/admin/categorias', nombre: 'Productos',      icono: 'i-tienda' },
  { ruta: '/admin/topventas',  nombre: 'Lo más vendido', icono: 'i-estrella' },
  { ruta: '/admin/ofertas',    nombre: 'Ofertas',        icono: 'i-etiqueta' },
];
---
<!doctype html>
<html lang="es-VE">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{titulo} — Panel de Casa Herramientas</title>
  <link rel="icon" href="/assets/logo.png">
</head>
<body class="admin">

  <svg style="display:none" aria-hidden="true">
    <symbol id="i-tienda" viewBox="0 0 24 24"><path d="M3 9 4.5 3h15L21 9"/><path d="M4 9v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/></symbol>
    <symbol id="i-etiqueta" viewBox="0 0 24 24"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.2"/></symbol>
    <symbol id="i-estrella" viewBox="0 0 24 24"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></symbol>
  </svg>

  <header class="admin-cabecera">
    <a class="admin-marca" href="/admin">
      <img src="/assets/logo.png" alt="">
      <span><strong>Casa Herramientas</strong><small>Panel de administración</small></span>
    </a>
    <nav class="admin-nav">
      <a href="/" target="_blank" rel="noopener">Ver la tienda ↗</a>
      <a class="admin-salir" href="/admin/salir">Salir</a>
    </nav>
  </header>

  <div class="admin-marco">
    <nav class="admin-lateral" aria-label="Secciones del panel">
      {SECCIONES.map((s) => (
        <a href={s.ruta} class={s.ruta === actual ? 'activa' : ''} aria-current={s.ruta === actual ? 'page' : undefined}>
          <svg class="ico"><use href={`#${s.icono}`}/></svg>
          <span>{s.nombre}</span>
        </a>
      ))}
    </nav>

    <main class="admin-cuerpo">
      <slot />
    </main>
  </div>
</body>
</html>
