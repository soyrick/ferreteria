---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import MenuProducto from '../../components/MenuProducto.astro';
import { resumen, productos, apiLista } from '../../datos/api.js';
import { leer, almacenListo, accionProducto } from '../../datos/curaduria.js';

let mensaje = null;

if (Astro.request.method === 'POST') {
  const accion = (await Astro.request.formData()).get('accion');
  const [que, codigo] = String(accion ?? '').split(':');
  if (que) mensaje = await accionProducto(que, codigo);
}

/* El catálogo tiene 8.437 productos: no se listan todos. Se busca y se pagina,
   que es como funciona la API. */
const POR_PAGINA = 24;
const q = Astro.url.searchParams.get('q') ?? '';
const categoria = Astro.url.searchParams.get('categoria') ?? '';
const pagina = Math.max(Number(Astro.url.searchParams.get('pagina')) || 1, 1);

let info = null;
let lista = { productos: [], total: 0 };
let fallo = '';

if (apiLista()) {
  try {
    [info, lista] = await Promise.all([
      resumen(),
      productos({ q, categoria, limit: POR_PAGINA, offset: (pagina - 1) * POR_PAGINA }),
    ]);
  } catch (e) {
    fallo = e.message;
  }
}

const estado = await leer();
const enTop = new Set(estado.topventas);
const enOferta = new Set(estado.ofertas.map((o) => o.codigo));

const paginas = Math.ceil(lista.total / POR_PAGINA);
const url = (p) => {
  const s = new URLSearchParams();
  if (q) s.set('q', q);
  if (categoria) s.set('categoria', categoria);
  if (p > 1) s.set('pagina', String(p));
  return `/admin/categorias${s.toString() ? `?${s}` : ''}`;
};
---
<Admin titulo="Productos">
  <header class="admin-titulo">
    <div>
      <h1>Productos</h1>
      <p>
        El catálogo completo del negocio, tal como llega de la API. Aquí no se
        editan nombres ni precios —eso vive en el sistema de la tienda—: el menú
        <strong>⋯</strong> manda un producto a Lo más vendido o a Ofertas.
      </p>
    </div>
  </header>

  {mensaje?.ok && <p class="admin-ok" role="status">{mensaje.ok}</p>}
  {mensaje?.aviso && <p class="admin-aviso" role="status">{mensaje.aviso}</p>}
  {mensaje?.error && <p class="admin-errores" role="alert">{mensaje.error}</p>}

  {!apiLista() && (
    <div class="admin-aviso">
      <strong>Falta configurar el catálogo.</strong>
      No encuentro <code>CATALOGO_URL</code> en el entorno.
    </div>
  )}

  {fallo && (
    <div class="admin-errores" role="alert">
      <strong>No pude consultar el catálogo.</strong> {fallo}
    </div>
  )}

  {!almacenListo() && (
    <div class="admin-aviso">
      <strong>Guardando solo en memoria.</strong>
      No encuentro <code>BLOB_READ_WRITE_TOKEN</code>. Los cambios se pierden al reiniciar.
    </div>
  )}

  <form method="GET" class="panel-buscador">
    <label for="q">Buscar</label>
    <input type="search" id="q" name="q" value={q} placeholder="Nombre, código o marca…" autocomplete="off">
    <select name="categoria" aria-label="Categoría">
      <option value="">Todas las categorías</option>
      {info?.categorias.map((c) => (
        <option value={c.nombre} selected={c.nombre === categoria}>{c.nombre} ({c.total})</option>
      ))}
    </select>
    <button type="submit" class="btn btn-negro">Buscar</button>
    <span class="panel-cuenta">{lista.total.toLocaleString('es-VE')} productos</span>
  </form>

  <form method="POST" class="admin-form">
    <section class="admin-seccion">
      {lista.productos.length === 0 && !fallo && (
        <p class="panel-sin">
          {q || categoria ? 'No hay productos que coincidan con esa búsqueda.' : 'El catálogo está vacío.'}
        </p>
      )}

      <div class="elegir">
        {lista.productos.map((p) => (
          <div class="elegir-fila">
            <div class="elegir-item sin-casilla">
              <span class="elegir-codigo">{p.codigo}</span>
              <span class="elegir-datos">
                <strong>{p.nombre}</strong>
                <small>
                  {[p.marca, p.categoria].filter(Boolean).join(' · ')}
                  {p.precio ? ` · $${p.precio.toFixed(2)}` : ' · sin precio'}
                  {!p.disponible && <em class="marca-vencida">agotado</em>}
                  {enTop.has(p.codigo) && <em class="marca-estrella">top ventas</em>}
                  {enOferta.has(p.codigo) && <em class="marca-oferta">en oferta</em>}
                </small>
              </span>
            </div>
            <MenuProducto id={p.codigo} acciones={[
              { valor: 'a-topventas', texto: 'Pasar a Lo más vendido' },
              { valor: 'a-oferta', texto: 'Poner en oferta' },
            ]} />
          </div>
        ))}
      </div>
    </section>
  </form>

  {paginas > 1 && (
    <nav class="panel-paginas" aria-label="Páginas">
      {pagina > 1 && <a href={url(pagina - 1)}>← Anterior</a>}
      <span>Página {pagina} de {paginas.toLocaleString('es-VE')}</span>
      {pagina < paginas && <a href={url(pagina + 1)}>Siguiente →</a>}
    </nav>
  )}

  <script>
    import '../../scripts/panel.js';
  </script>
</Admin>
