---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import MenuProducto from '../../components/MenuProducto.astro';
import { CATEGORIAS, idDe } from '../../datos/catalogo.js';
import { leer, guardar, almacenListo, accionProducto } from '../../datos/curaduria.js';

let errores = [];
let mensaje = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = f.get('accion');

  if (accion) {
    // Menú "⋯": una sola acción sobre un producto.
    const [que, id] = String(accion).split(':');
    mensaje = await accionProducto(que, id);
  } else {
    // Guardado en bloque de las casillas.
    const destacados = Object.fromEntries(
      CATEGORIAS.map((c) => [c.id, f.getAll(`cat:${c.id}`).map(String)])
    );
    errores = await guardar({ destacados });
    if (!errores.length) mensaje = { ok: 'Listo. La página principal ya muestra esta selección.' };
  }
}

const estado = await leer();
const actual = estado.destacados;
const enEstrella = new Set(estado.semana);
const enOferta = new Set(estado.ofertas.map((o) => o.id));
const totalProductos = CATEGORIAS.reduce((n, c) => n + c.productos.length, 0);
---
<Admin titulo="Categorías">
  <header class="admin-titulo">
    <div>
      <h1>Productos</h1>
      <p>
        Todo el catálogo, agrupado por categoría. La casilla decide si el producto
        sale en la fila de su categoría en la página principal. El menú <strong>⋯</strong>
        lo manda a Productos estrella o a Ofertas.
      </p>
    </div>
  </header>

  {mensaje?.ok && <p class="admin-ok" role="status">{mensaje.ok}</p>}
  {mensaje?.aviso && <p class="admin-aviso" role="status">{mensaje.aviso}</p>}
  {mensaje?.error && <p class="admin-errores" role="alert">{mensaje.error}</p>}
  {errores.length > 0 && (
    <ul class="admin-errores" role="alert">{errores.map((e) => <li>{e}</li>)}</ul>
  )}

  {!almacenListo() && (
    <div class="admin-aviso">
      <strong>Guardando solo en memoria.</strong>
      No encuentro <code>BLOB_READ_WRITE_TOKEN</code>. Los cambios se pierden al reiniciar.
    </div>
  )}

  <div class="panel-buscador">
    <label for="buscar-producto">Buscar</label>
    <input type="search" id="buscar-producto" placeholder="Nombre o marca…" autocomplete="off">
    <span class="panel-cuenta">{totalProductos} productos</span>
  </div>

  <form method="POST" id="form-categorias" class="admin-form">
    {CATEGORIAS.map((c) => {
      const elegidos = actual[c.id] ?? [];
      return (
        <section class="admin-seccion" data-grupo>
          <h2>{c.nombre} <span class="admin-cuenta">{elegidos.length} en la página</span></h2>
          <div class="elegir">
            {c.productos.map((p) => {
              const id = idDe(p);
              return (
                <div class="elegir-fila" data-busca={`${p.n} ${p.m}`}>
                  <label class="elegir-item">
                    <input type="checkbox" name={`cat:${c.id}`} value={id} checked={elegidos.includes(id)}>
                    <img src={`/assets/img/${p.img}.jpg`} alt="" loading="lazy">
                    <span class="elegir-datos">
                      <strong>{p.n}</strong>
                      <small>
                        {p.m} · ${p.p.toFixed(2)}
                        {enEstrella.has(id) && <em class="marca-estrella">estrella</em>}
                        {enOferta.has(id) && <em class="marca-oferta">en oferta</em>}
                      </small>
                    </span>
                  </label>
                  <MenuProducto id={id} acciones={[
                    { valor: 'a-estrella', texto: 'Pasar a Productos estrella' },
                    { valor: 'a-oferta', texto: 'Poner en oferta' },
                  ]} />
                </div>
              );
            })}
          </div>
        </section>
      );
    })}

    <p class="panel-sin" id="sin-coincidencias" hidden>
      No hay productos que coincidan con “<span data-termino></span>”.
    </p>

    <div class="admin-pie-form">
      <button type="submit" class="btn btn-amarillo">Guardar cambios</button>
    </div>
  </form>

  <script>
    import '../../scripts/panel.js';
  </script>
</Admin>
