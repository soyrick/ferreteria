---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { resumen, apiLista } from '../../datos/api.js';
import { leer, almacenListo } from '../../datos/curaduria.js';
import { visitas, ga4Listo } from '../../lib/ga4.js';

/* Esta pantalla solo muestra lo que se puede comprobar.

   Tenía métricas, una gráfica de visitas y dos tablas de páginas y búsquedas
   más vistas: todo inventado, con un cartelito de "muestra" al lado. Servía
   para ver cómo iba a quedar, pero un panel con números falsos es peor que uno
   vacío — se los termina leyendo como si fueran ciertos.

   Las cifras de verdad llegan cuando se conecten la GA4 Data API y la Search
   Console API, que piden credenciales de cuenta de servicio. */

const GA_ID = import.meta.env.PUBLIC_GA_ID ?? '';

const conexiones = [
  {
    nombre: 'Google Analytics 4',
    variable: 'PUBLIC_GA_ID',
    listo: Boolean(GA_ID),
    detalle: GA_ID
      ? `Midiendo con ${GA_ID}. Las visitas se registran; las cifras se ven en analytics.google.com`
      : 'Falta el ID de medición (G-XXXXXXXXXX)',
  },
  {
    /* Las cifras de visitas de esta pantalla salen de acá, no del `G-…`.
       Son dos cosas distintas: el ID de medición hace que se registren, y la
       cuenta de servicio es lo que deja leerlas. */
    nombre: 'Google Analytics · lectura de datos',
    variable: 'GA_PROPIEDAD · GA_CUENTA_CORREO · GA_CUENTA_CLAVE',
    listo: ga4Listo(),
    detalle: ga4Listo()
      ? 'Cuenta de servicio configurada: las visitas se ven más abajo'
      : 'Faltan las credenciales para leer las visitas desde acá',
  },
  {
    /* El sitio se verificó con un registro TXT en el DNS, no con la etiqueta
       en el HTML. Esta fila describe un hecho del dominio, no una conexión que
       haga la aplicación: no consumimos la API de Search Console. */
    nombre: 'Google Search Console',
    variable: 'registro TXT en el DNS',
    listo: true,
    detalle: 'Dominio verificado el 2026-09-07. El panel todavía no lee su API.',
  },
  {
    nombre: 'Catálogo de productos',
    variable: 'CATALOGO_URL',
    listo: apiLista(),
    detalle: apiLista() ? 'Conectado' : 'Falta la URL del catálogo',
  },
  {
    nombre: 'Almacenamiento de la curaduría',
    variable: 'BLOB_READ_WRITE_TOKEN',
    listo: almacenListo(),
    detalle: almacenListo()
      ? 'Vercel Blob conectado: los cambios se guardan'
      : 'Sin token: los cambios se pierden al reiniciar',
  },
];

/* Lo único medible desde acá: qué hay en el catálogo y qué está publicado. */
let catalogo = null;
if (apiLista()) {
  try {
    const info = await resumen();
    catalogo = {
      productos: info.totalProductos,
      categorias: info.categorias.length,
      marcas: info.marcas?.length ?? 0,
    };
  } catch { /* si la API no responde, la tarjeta no se muestra */ }
}

const estado = await leer();
const vitrinas = {
  categorias: estado.categorias.length,
  topventas: estado.topventas.length,
  ofertas: estado.ofertas.length,
};

/* Las visitas. Si algo falla —faltan variables, Google dice que no, se cae la
   red— la sección vuelve al aviso de siempre y el detalle queda en el log.
   Nunca un número inventado: es la misma regla por la que se borraron las
   métricas de muestra, y vale igual cuando el que falla es Google. */
let trafico = null;
let motivoTrafico = 'Faltan las credenciales de la cuenta de servicio de Google.';

if (ga4Listo()) {
  try {
    trafico = await visitas();
  } catch (e) {
    console.error('[admin] GA4 falló:', e.message);
    motivoTrafico = 'Google Analytics no respondió en este momento.';
  }
}

const mil = (n) => Number(n).toLocaleString('es-VE');

/* El gráfico de visitas por día, en SVG armado acá.

   ponytail: sin `chart.js`. La regla R3 pide que una dependencia borre código
   propio o resuelva algo que no se hace en cincuenta líneas; 28 barras no
   califican. Además esto lo pinta el servidor: el panel no recibe una sola
   línea de JavaScript por el gráfico, y se ve igual con el JS apagado.
   El techo es si algún día hacen falta ejes, zoom o varias series encimadas —
   ahí sí entra una librería. */
const ALTO = 120;
const ANCHO = 620;
const HUECO = 3;

const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const comoDia = (d) => `${d.dia} ${MESES[d.mes - 1]}`;

let grafico = null;
if (trafico?.diario?.length) {
  const serie = trafico.diario;
  const tope = Math.max(...serie.map((d) => d.visitas), 1);
  const ancho = ANCHO / serie.length;

  grafico = {
    tope,
    desde: comoDia(serie[0]),
    hasta: comoDia(serie[serie.length - 1]),
    /* Una barra de altura cero no se ve. Los días sin visitas llevan 2px para
       que se note que el día existe y estuvo en cero, en vez de parecer un
       hueco en los datos. */
    barras: serie.map((d, i) => ({
      x: i * ancho,
      ancho: Math.max(ancho - HUECO, 1),
      alto: d.visitas ? Math.max((d.visitas / tope) * ALTO, 2) : 2,
      cero: d.visitas === 0,
      titulo: `${comoDia(d)}: ${d.visitas} ${d.visitas === 1 ? 'visita' : 'visitas'}`,
    })),
  };
}
---
<Admin titulo="Estadísticas">
  <header class="admin-titulo">
    <div>
      <h1>Estado de la tienda</h1>
      <p>Lo que está conectado y lo que hay publicado ahora mismo.</p>
    </div>
  </header>

  <section class="admin-seccion">
    <h2>Conexiones</h2>
    <div class="admin-conexiones">
      {conexiones.map((c) => (
        <article class={`conexion ${c.listo ? 'lista' : 'pendiente'}`}>
          <span class="conexion-punto"></span>
          <div>
            <strong>{c.nombre}</strong>
            <span>{c.detalle}</span>
            <code>{c.variable}</code>
          </div>
        </article>
      ))}
    </div>
  </section>

  {catalogo && (
    <section class="admin-seccion">
      <h2>El catálogo</h2>
      <p class="admin-fuente">Lo que trae la API del negocio en este momento.</p>
      <div class="admin-metricas">
        <article class="metrica">
          <span class="metrica-etiqueta">Productos</span>
          <strong class="metrica-valor">{catalogo.productos.toLocaleString('es-VE')}</strong>
        </article>
        <article class="metrica">
          <span class="metrica-etiqueta">Categorías</span>
          <strong class="metrica-valor">{catalogo.categorias}</strong>
        </article>
        <article class="metrica">
          <span class="metrica-etiqueta">Marcas</span>
          <strong class="metrica-valor">{catalogo.marcas}</strong>
        </article>
      </div>
    </section>
  )}

  <section class="admin-seccion">
    <h2>Lo que se ve en la página principal</h2>
    <p class="admin-fuente">Lo que elegiste en las otras pantallas.</p>
    <div class="admin-metricas">
      <article class="metrica">
        <span class="metrica-etiqueta">Categorías en la portada</span>
        <strong class="metrica-valor">{vitrinas.categorias || 'Las 8 más grandes'}</strong>
      </article>
      <article class="metrica">
        <span class="metrica-etiqueta">Lo más vendido</span>
        <strong class="metrica-valor">{vitrinas.topventas}</strong>
      </article>
      <article class="metrica">
        <span class="metrica-etiqueta">En oferta</span>
        <strong class="metrica-valor">{vitrinas.ofertas}</strong>
      </article>
    </div>
  </section>

  <section class="admin-seccion">
    <h2>Visitas y búsquedas</h2>

    {trafico ? (
      <>
        <p class="admin-fuente">Lo que midió Google Analytics. Últimos 28 días, salvo donde diga otra cosa.</p>
        <div class="admin-metricas">
          <article class="metrica">
            <span class="metrica-etiqueta">Visitas · 7 días</span>
            <strong class="metrica-valor">{mil(trafico.visitas7)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Visitas · 28 días</span>
            <strong class="metrica-valor">{mil(trafico.visitas28)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Personas distintas · 28 días</span>
            <strong class="metrica-valor">{mil(trafico.personas28)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Búsquedas</span>
            <strong class="metrica-valor">{mil(trafico.eventos.search ?? 0)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Agregados al pedido</span>
            <strong class="metrica-valor">{mil(trafico.eventos.add_to_cart ?? 0)}</strong>
          </article>
        </div>

        {grafico && (
          <>
            <h3 class="admin-subtitulo">Visitas por día</h3>
            <div class="grafico">
              {/* role="img" con su etiqueta: un lector de pantalla no puede leer
                  barras, así que se le da el resumen que se ve de un vistazo. */}
              <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="none"
                   role="img" class="grafico-svg"
                   aria-label={`Visitas por día del ${grafico.desde} al ${grafico.hasta}. Máximo ${grafico.tope} en un día.`}>
                {grafico.barras.map((b) => (
                  <rect x={b.x} y={ALTO - b.alto} width={b.ancho} height={b.alto}
                        class={b.cero ? 'barra vacia' : 'barra'} rx="1">
                    <title>{b.titulo}</title>
                  </rect>
                ))}
              </svg>
              <div class="grafico-pie">
                <span>{grafico.desde}</span>
                <span class="grafico-tope">máx. {mil(grafico.tope)} en un día</span>
                <span>{grafico.hasta}</span>
              </div>
            </div>
          </>
        )}

        {trafico.paginas.length > 0 && (
          <>
            <h3 class="admin-subtitulo">Páginas más vistas</h3>
            <table class="admin-tabla">
              <thead><tr><th>Página</th><th>Vistas</th></tr></thead>
              <tbody>
                {trafico.paginas.map((p) => (
                  <tr>
                    <td><code>{p.ruta}</code></td>
                    <td>{mil(p.vistas)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}

        {trafico.terminos.length > 0 ? (
          <>
            <h3 class="admin-subtitulo">Lo que busca la gente</h3>
            <table class="admin-tabla">
              <thead><tr><th>Término</th><th>Veces</th></tr></thead>
              <tbody>
                {trafico.terminos.map((t) => (
                  <tr>
                    <td>{t.termino}</td>
                    <td>{mil(t.veces)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="admin-fuente">
              Sirve para saber qué te están pidiendo que no tienes en el catálogo.
            </p>
          </>
        ) : (
          /* Se dice qué NO se está mostrando, para que nadie lea el número de
             búsquedas como si fuera la lista de lo que busca la gente. */
          <p class="admin-fuente">
            Cuántas búsquedas hubo, no cuáles. Para ver los términos hay que crear
            una dimensión personalizada en Google Analytics con el parámetro
            <code>search_term</code>. Google los guarda desde que se crea, no antes.
          </p>
        )}
      </>
    ) : (
      <div class="admin-aviso">
        <strong>Todavía no se ven acá.</strong>
        {motivoTrafico} Mientras tanto se consultan en
        <a href="https://analytics.google.com" target="_blank" rel="noopener">analytics.google.com</a>,
        donde sí se están registrando.
      </div>
    )}
  </section>
</Admin>
