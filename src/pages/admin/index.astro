---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { resumen, apiLista } from '../../datos/api.js';
import { leer, almacenListo } from '../../datos/curaduria.js';
import { visitas, ga4Listo } from '../../lib/ga4.js';

/* Esta pantalla solo muestra lo que se puede comprobar.

   Tenía métricas, una gráfica de visitas y dos tablas de páginas y búsquedas
   más vistas: todo inventado, con un cartelito de "muestra" al lado. Servía
   para ver cómo iba a quedar, pero un panel con números falsos es peor que uno
   vacío — se los termina leyendo como si fueran ciertos.

   Las cifras de verdad llegan cuando se conecten la GA4 Data API y la Search
   Console API, que piden credenciales de cuenta de servicio. */

const GA_ID = import.meta.env.PUBLIC_GA_ID ?? '';

const conexiones = [
  {
    nombre: 'Google Analytics 4',
    variable: 'PUBLIC_GA_ID',
    listo: Boolean(GA_ID),
    detalle: GA_ID
      ? `Midiendo con ${GA_ID}. Las visitas se registran; las cifras se ven en analytics.google.com`
      : 'Falta el ID de medición (G-XXXXXXXXXX)',
  },
  {
    /* Las cifras de visitas de esta pantalla salen de acá, no del `G-…`.
       Son dos cosas distintas: el ID de medición hace que se registren, y la
       cuenta de servicio es lo que deja leerlas. */
    nombre: 'Google Analytics · lectura de datos',
    variable: 'GA_PROPIEDAD · GA_CUENTA_CORREO · GA_CUENTA_CLAVE',
    listo: ga4Listo(),
    detalle: ga4Listo()
      ? 'Cuenta de servicio configurada: las visitas se ven más abajo'
      : 'Faltan las credenciales para leer las visitas desde acá',
  },
  {
    /* El sitio se verificó con un registro TXT en el DNS, no con la etiqueta
       en el HTML. Esta fila describe un hecho del dominio, no una conexión que
       haga la aplicación: no consumimos la API de Search Console. */
    nombre: 'Google Search Console',
    variable: 'registro TXT en el DNS',
    listo: true,
    detalle: 'Dominio verificado el 2026-09-07. El panel todavía no lee su API.',
  },
  {
    nombre: 'Catálogo de productos',
    variable: 'CATALOGO_URL',
    listo: apiLista(),
    detalle: apiLista() ? 'Conectado' : 'Falta la URL del catálogo',
  },
  {
    nombre: 'Almacenamiento de la curaduría',
    variable: 'BLOB_READ_WRITE_TOKEN',
    listo: almacenListo(),
    detalle: almacenListo()
      ? 'Vercel Blob conectado: los cambios se guardan'
      : 'Sin token: los cambios se pierden al reiniciar',
  },
];

/* Lo único medible desde acá: qué hay en el catálogo y qué está publicado. */
let catalogo = null;
if (apiLista()) {
  try {
    const info = await resumen();
    catalogo = {
      productos: info.totalProductos,
      categorias: info.categorias.length,
      marcas: info.marcas?.length ?? 0,
    };
  } catch { /* si la API no responde, la tarjeta no se muestra */ }
}

const estado = await leer();
const vitrinas = {
  categorias: estado.categorias.length,
  topventas: estado.topventas.length,
  ofertas: estado.ofertas.length,
};

/* Las visitas. Si algo falla —faltan variables, Google dice que no, se cae la
   red— la sección vuelve al aviso de siempre y el detalle queda en el log.
   Nunca un número inventado: es la misma regla por la que se borraron las
   métricas de muestra, y vale igual cuando el que falla es Google. */
let trafico = null;
let motivoTrafico = 'Faltan las credenciales de la cuenta de servicio de Google.';

if (ga4Listo()) {
  try {
    trafico = await visitas();
  } catch (e) {
    console.error('[admin] GA4 falló:', e.message);
    motivoTrafico = 'Google Analytics no respondió en este momento.';
  }
}

const mil = (n) => Number(n).toLocaleString('es-VE');

/* El gráfico de visitas por día: línea con área debajo.

   ponytail: sin `chart.js`. La regla R3 pide que una dependencia borre código
   propio o resuelva algo que no se hace en cincuenta líneas. Además esto lo
   pinta el servidor: el panel no recibe una sola línea de JavaScript por el
   gráfico, y se ve igual con el JS apagado. El techo es si algún día hacen
   falta zoom o varias series encimadas.

   Lleva números y fechas escritos, no solo la forma. Quien mira esto quiere
   saber cuánta gente entró tal día, y eso se responde leyendo, no midiendo a
   ojo contra un eje. */
const ANCHO = 720;
const ALTO = 260;
const M = { arriba: 26, derecha: 18, abajo: 44, izquierda: 46 };
const AREA = { ancho: ANCHO - M.izquierda - M.derecha, alto: ALTO - M.arriba - M.abajo };
const PISO = M.arriba + AREA.alto;

const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const comoDia = (d) => `${d.dia} ${MESES[d.mes - 1]}`;

let grafico = null;
if (trafico?.diario?.length > 1) {
  const serie = trafico.diario;
  const tope = Math.max(...serie.map((d) => d.visitas), 1);

  /* El eje se redondea a un número cómodo para que las líneas guía caigan en
     valores que se leen de un vistazo: 10 y 5, no 9,33 y 4,67. */
  const paso = tope <= 4 ? 1 : tope <= 10 ? 2 : tope <= 30 ? 5 : 10;
  const techo = Math.ceil(tope / paso) * paso;

  const x = (i) => M.izquierda + (i / (serie.length - 1)) * AREA.ancho;
  const y = (v) => PISO - (v / techo) * AREA.alto;

  const puntos = serie.map((d, i) => ({
    x: Number(x(i).toFixed(1)),
    y: Number(y(d.visitas).toFixed(1)),
    visitas: d.visitas,
    dia: comoDia(d),
  }));

  const linea = puntos.map((p, i) => `${i ? 'L' : 'M'}${p.x} ${p.y}`).join(' ');

  /* Con muchos días las fechas se amontonan y no se leen: se saltean, pero la
     primera y la última entran siempre. */
  const cada = Math.max(1, Math.ceil(serie.length / 7));

  const guias = [];
  for (let v = 0; v <= techo; v += paso) guias.push({ v, y: Number(y(v).toFixed(1)) });

  grafico = {
    ancho: ANCHO, alto: ALTO, piso: PISO, techo, guias, puntos, linea,
    area: `${linea} L${puntos[puntos.length - 1].x} ${PISO} L${puntos[0].x} ${PISO} Z`,
    fechas: puntos.filter((_, i) => i % cada === 0 || i === puntos.length - 1),
    desde: comoDia(serie[0]),
    hasta: comoDia(serie[serie.length - 1]),
    total: serie.reduce((a, d) => a + d.visitas, 0),
    pico: puntos.reduce((a, p) => (p.visitas > a.visitas ? p : a), puntos[0]),
  };
}

/* Las direcciones no le dicen nada a nadie: "/categoria/automotriz" es ruido
   cuando lo que se quiere saber es qué mira la gente. Se traducen al nombre
   que se ve en la tienda. */
const capitalizar = (t) => t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
const desdeRanura = (r) => capitalizar(decodeURIComponent(r).replace(/-/g, ' '));

function nombreDePagina(ruta) {
  const limpia = (ruta || '/').split('?')[0];
  if (limpia === '/') return { que: 'La página principal', tipo: 'Inicio' };
  const cat = limpia.match(/^\/categoria\/([^/]+)/);
  if (cat) return { que: desdeRanura(cat[1]), tipo: 'Categoría' };
  const prod = limpia.match(/^\/producto\/([^/]+)\/[^/]+$/);
  if (prod) return { que: desdeRanura(prod[1]), tipo: 'Producto' };
  if (limpia.startsWith('/producto/')) return { que: limpia.split('/').pop(), tipo: 'Producto' };
  if (limpia.startsWith('/privacidad')) return { que: 'Política de privacidad', tipo: 'Página' };
  return { que: limpia, tipo: 'Página' };
}

/* Cada fila lleva una barra proporcional a la más vista: comparar largos es
   inmediato, comparar números escritos obliga a hacer la cuenta. */
const topPaginas = (trafico?.paginas ?? []).map((p, _i, todas) => ({
  ...nombreDePagina(p.ruta),
  vistas: p.vistas,
  ancho: Math.max(Math.round((p.vistas / Math.max(todas[0].vistas, 1)) * 100), 2),
}));
---
<Admin titulo="Estadísticas">
  <header class="admin-titulo">
    <div>
      <h1>Estado de la tienda</h1>
      <p>Lo que está conectado y lo que hay publicado ahora mismo.</p>
    </div>
  </header>

  <section class="admin-seccion">
    <h2>Conexiones</h2>
    <div class="admin-conexiones">
      {conexiones.map((c) => (
        <article class={`conexion ${c.listo ? 'lista' : 'pendiente'}`}>
          <span class="conexion-punto"></span>
          <div>
            <strong>{c.nombre}</strong>
            <span>{c.detalle}</span>
            <code>{c.variable}</code>
          </div>
        </article>
      ))}
    </div>
  </section>

  {catalogo && (
    <section class="admin-seccion">
      <h2>El catálogo</h2>
      <p class="admin-fuente">Lo que trae la API del negocio en este momento.</p>
      <div class="admin-metricas">
        <article class="metrica">
          <span class="metrica-etiqueta">Productos</span>
          <strong class="metrica-valor">{catalogo.productos.toLocaleString('es-VE')}</strong>
        </article>
        <article class="metrica">
          <span class="metrica-etiqueta">Categorías</span>
          <strong class="metrica-valor">{catalogo.categorias}</strong>
        </article>
        <article class="metrica">
          <span class="metrica-etiqueta">Marcas</span>
          <strong class="metrica-valor">{catalogo.marcas}</strong>
        </article>
      </div>
    </section>
  )}

  <section class="admin-seccion">
    <h2>Lo que se ve en la página principal</h2>
    <p class="admin-fuente">Lo que elegiste en las otras pantallas.</p>
    <div class="admin-metricas">
      <article class="metrica">
        <span class="metrica-etiqueta">Categorías en la portada</span>
        <strong class="metrica-valor">{vitrinas.categorias || 'Las 8 más grandes'}</strong>
      </article>
      <article class="metrica">
        <span class="metrica-etiqueta">Lo más vendido</span>
        <strong class="metrica-valor">{vitrinas.topventas}</strong>
      </article>
      <article class="metrica">
        <span class="metrica-etiqueta">En oferta</span>
        <strong class="metrica-valor">{vitrinas.ofertas}</strong>
      </article>
    </div>
  </section>

  <section class="admin-seccion">
    <h2>Visitas y búsquedas</h2>

    {trafico ? (
      <>
        <p class="admin-fuente">Lo que midió Google Analytics. Últimos 28 días, salvo donde diga otra cosa.</p>
        <div class="admin-metricas">
          <article class="metrica">
            <span class="metrica-etiqueta">Visitas · 7 días</span>
            <strong class="metrica-valor">{mil(trafico.visitas7)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Visitas · 28 días</span>
            <strong class="metrica-valor">{mil(trafico.visitas28)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Personas distintas · 28 días</span>
            <strong class="metrica-valor">{mil(trafico.personas28)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Búsquedas</span>
            <strong class="metrica-valor">{mil(trafico.eventos.search ?? 0)}</strong>
          </article>
          <article class="metrica">
            <span class="metrica-etiqueta">Agregados al pedido</span>
            <strong class="metrica-valor">{mil(trafico.eventos.add_to_cart ?? 0)}</strong>
          </article>
        </div>

        {grafico && (
          <>
            <h3 class="admin-subtitulo">Visitas por día</h3>
            <p class="admin-fuente">
              {mil(grafico.total)} visitas entre el {grafico.desde} y el {grafico.hasta}.
              El día más movido fue el {grafico.pico.dia}, con {mil(grafico.pico.visitas)}.
            </p>
            <div class="grafico">
              {/* Un lector de pantalla no puede leer una línea: se le da el
                  mismo resumen que está escrito arriba. */}
              <svg viewBox={`0 0 ${grafico.ancho} ${grafico.alto}`} class="grafico-svg" role="img"
                   aria-label={`Visitas por día del ${grafico.desde} al ${grafico.hasta}. En total ${grafico.total}. El máximo fue ${grafico.pico.visitas} el ${grafico.pico.dia}.`}>

                {grafico.guias.map((g) => (
                  <>
                    <line x1="46" y1={g.y} x2={grafico.ancho - 18} y2={g.y} class="guia" />
                    <text x="38" y={g.y + 4} class="eje" text-anchor="end">{g.v}</text>
                  </>
                ))}

                <path d={grafico.area} class="area" />
                <path d={grafico.linea} class="linea" />

                {grafico.puntos.map((p) => (
                  <circle cx={p.x} cy={p.y} r="4.5" class="punto">
                    <title>{p.dia}: {p.visitas} {p.visitas === 1 ? 'visita' : 'visitas'}</title>
                  </circle>
                ))}

                {/* El número del día más alto, escrito. Es el dato que se busca
                    al mirar el gráfico y no hay por qué estimarlo. */}
                <text x={grafico.pico.x} y={grafico.pico.y - 13} class="pico" text-anchor="middle">
                  {grafico.pico.visitas}
                </text>

                {grafico.fechas.map((f) => (
                  <text x={f.x} y={grafico.piso + 26} class="eje" text-anchor="middle">{f.dia}</text>
                ))}
              </svg>
            </div>
          </>
        )}

        {topPaginas.length > 0 && (
          <>
            <h3 class="admin-subtitulo">Lo más visitado</h3>
            <p class="admin-fuente">Las páginas que más miró la gente en los últimos 28 días.</p>
            <ol class="ranking">
              {topPaginas.map((p, i) => (
                <li class="ranking-fila">
                  <span class="ranking-puesto">{i + 1}</span>
                  <span class="ranking-datos">
                    <strong>{p.que}</strong>
                    <small>{p.tipo}</small>
                  </span>
                  <span class="ranking-barra" aria-hidden="true">
                    <span class="ranking-relleno" style={`width:${p.ancho}%`}></span>
                  </span>
                  <span class="ranking-cifra">
                    {mil(p.vistas)} <small>{p.vistas === 1 ? 'visita' : 'visitas'}</small>
                  </span>
                </li>
              ))}
            </ol>
          </>
        )}

        <h3 class="admin-subtitulo">Lo que busca la gente</h3>
        {trafico.terminos.length > 0 ? (
          <>
            <ol class="ranking">
              {trafico.terminos.map((t, i) => (
                <li class="ranking-fila">
                  <span class="ranking-puesto">{i + 1}</span>
                  <span class="ranking-datos"><strong>{t.termino}</strong></span>
                  <span class="ranking-cifra">
                    {mil(t.veces)} <small>{t.veces === 1 ? 'vez' : 'veces'}</small>
                  </span>
                </li>
              ))}
            </ol>
            <p class="admin-fuente">
              Sirve para saber qué te están pidiendo que no tienes en el catálogo.
            </p>
          </>
        ) : trafico.terminosEstado === 'sin-dimension' ? (
          <p class="admin-fuente">
            Para ver los términos hay que crear una dimensión personalizada en
            Google Analytics con el parámetro <code>search_term</code>.
          </p>
        ) : (
          /* La dimensión ya está creada: no hay nada que pedirle a nadie, solo
             esperar. Decirle a alguien que cree algo que ya creó es la clase de
             mensaje que hace desconfiar de la pantalla entera. */
          <p class="admin-fuente">
            Todavía no hay términos que mostrar. Google los empezó a guardar el
            7 de septiembre y no rellena hacia atrás, así que van a ir apareciendo
            a medida que la gente busque.
          </p>
        )}
      </>
    ) : (
      <div class="admin-aviso">
        <strong>Todavía no se ven acá.</strong>
        {motivoTrafico} Mientras tanto se consultan en
        <a href="https://analytics.google.com" target="_blank" rel="noopener">analytics.google.com</a>,
        donde sí se están registrando.
      </div>
    )}
  </section>
</Admin>
