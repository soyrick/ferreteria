---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { resumen, apiLista } from '../../datos/api.js';
import { leer, almacenListo } from '../../datos/curaduria.js';

/* Esta pantalla solo muestra lo que se puede comprobar.

   Tenía métricas, una gráfica de visitas y dos tablas de páginas y búsquedas
   más vistas: todo inventado, con un cartelito de "muestra" al lado. Servía
   para ver cómo iba a quedar, pero un panel con números falsos es peor que uno
   vacío — se los termina leyendo como si fueran ciertos.

   Las cifras de verdad llegan cuando se conecten la GA4 Data API y la Search
   Console API, que piden credenciales de cuenta de servicio. */

const GA_ID = import.meta.env.PUBLIC_GA_ID ?? '';
const GSC_TOKEN = import.meta.env.PUBLIC_GSC_VERIFICACION ?? '';

const conexiones = [
  {
    nombre: 'Google Analytics 4',
    variable: 'PUBLIC_GA_ID',
    listo: Boolean(GA_ID),
    detalle: GA_ID
      ? `Midiendo con ${GA_ID}. Las visitas se registran; las cifras se ven en analytics.google.com`
      : 'Falta el ID de medición (G-XXXXXXXXXX)',
  },
  {
    nombre: 'Google Search Console',
    variable: 'PUBLIC_GSC_VERIFICACION',
    listo: Boolean(GSC_TOKEN),
    detalle: GSC_TOKEN
      ? 'Etiqueta de verificación publicada'
      : 'Falta el token de verificación del dominio',
  },
  {
    nombre: 'Catálogo de productos',
    variable: 'CATALOGO_URL',
    listo: apiLista(),
    detalle: apiLista() ? 'Conectado' : 'Falta la URL del catálogo',
  },
  {
    nombre: 'Almacenamiento de la curaduría',
    variable: 'BLOB_READ_WRITE_TOKEN',
    listo: almacenListo(),
    detalle: almacenListo()
      ? 'Vercel Blob conectado: los cambios se guardan'
      : 'Sin token: los cambios se pierden al reiniciar',
  },
];

/* Lo único medible desde acá: qué hay en el catálogo y qué está publicado. */
let catalogo = null;
if (apiLista()) {
  try {
    const info = await resumen();
    catalogo = {
      productos: info.totalProductos,
      categorias: info.categorias.length,
      marcas: info.marcas?.length ?? 0,
    };
  } catch { /* si la API no responde, la tarjeta no se muestra */ }
}

const estado = await leer();
const vitrinas = {
  categorias: estado.categorias.length,
  topventas: estado.topventas.length,
  ofertas: estado.ofertas.length,
};
---
<Admin titulo="Estadísticas">
  <header class="admin-titulo">
    <div>
      <h1>Estado de la tienda</h1>
      <p>Lo que está conectado y lo que hay publicado ahora mismo.</p>
    </div>
  </header>

  <section class="admin-seccion">
    <h2>Conexiones</h2>
    <div class="admin-conexiones">
      {conexiones.map((c) => (
        <article class={`conexion ${c.listo ? 'lista' : 'pendiente'}`}>
          <span class="conexion-punto"></span>
          <div>
            <strong>{c.nombre}</strong>
            <span>{c.detalle}</span>
            <code>{c.variable}</code>
          </div>
        </article>
      ))}
    </div>
  </section>

  {catalogo && (
    <section class="admin-seccion">
      <h2>El catálogo</h2>
      <p class="admin-fuente">Lo que trae la API del negocio en este momento.</p>
      <div class="admin-metricas">
        <article class="metrica">
          <span class="metrica-etiqueta">Productos</span>
          <strong class="metrica-valor">{catalogo.productos.toLocaleString('es-VE')}</strong>
        </article>
        <article class="metrica">
          <span class="metrica-etiqueta">Categorías</span>
          <strong class="metrica-valor">{catalogo.categorias}</strong>
        </article>
        <article class="metrica">
          <span class="metrica-etiqueta">Marcas</span>
          <strong class="metrica-valor">{catalogo.marcas}</strong>
        </article>
      </div>
    </section>
  )}

  <section class="admin-seccion">
    <h2>Lo que se ve en la página principal</h2>
    <p class="admin-fuente">Lo que elegiste en las otras pantallas.</p>
    <div class="admin-metricas">
      <article class="metrica">
        <span class="metrica-etiqueta">Categorías en la portada</span>
        <strong class="metrica-valor">{vitrinas.categorias || 'Las 8 más grandes'}</strong>
      </article>
      <article class="metrica">
        <span class="metrica-etiqueta">Lo más vendido</span>
        <strong class="metrica-valor">{vitrinas.topventas}</strong>
      </article>
      <article class="metrica">
        <span class="metrica-etiqueta">En oferta</span>
        <strong class="metrica-valor">{vitrinas.ofertas}</strong>
      </article>
    </div>
  </section>

  <section class="admin-seccion">
    <h2>Visitas y búsquedas</h2>
    <div class="admin-aviso">
      <strong>Todavía no se ven acá.</strong>
      Las visitas ya se están registrando: se consultan en
      <a href="https://analytics.google.com" target="_blank" rel="noopener">analytics.google.com</a>.
      Traerlas a esta pantalla necesita credenciales de cuenta de servicio de
      Google, que es lo que falta.
    </div>
  </section>
</Admin>
