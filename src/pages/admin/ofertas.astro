---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import MenuProducto from '../../components/MenuProducto.astro';
import { producto } from '../../datos/api.js';
import { leer, guardar, almacenListo, accionProducto, ofertaVigente, limpiarHuerfanos } from '../../datos/curaduria.js';

let errores = [];
let mensaje = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = f.get('accion');

  if (accion === 'limpiar-huerfanos') {
    mensaje = await limpiarHuerfanos();
  } else if (accion) {
    const [que, codigo] = String(accion).split(':');
    mensaje = await accionProducto(que, codigo);
  } else {
    // Guardado en bloque de precios y vencimientos.
    const ofertas = f.getAll('oferta').map(String).map((codigo) => ({
      codigo,
      precio: Number(String(f.get(`precio:${codigo}`) ?? '').replace(',', '.')),
      // Indefinida se guarda como fecha vacía: es lo que ya entiende ofertaVigente().
      vence: f.get(`indef:${codigo}`) ? '' : String(f.get(`vence:${codigo}`) ?? ''),
    }));
    errores = await guardar({ ofertas });
    if (!errores.length) mensaje = { ok: 'Listo. Las ofertas quedaron publicadas.' };
  }
}

const estado = await leer();
const enTop = new Set(estado.topventas);

/* El precio de lista lo manda la API, no la curaduría: si el negocio sube el
   precio, el descuento se recalcula solo la próxima vez que se abra esto. */
const activas = await Promise.all(
  estado.ofertas.map(async (o) => ({
    ...o,
    p: await producto(o.codigo).catch(() => null),
    vigente: ofertaVigente(o),
  })),
);
const vencidas = activas.filter((o) => o.p && !o.vigente).length;
// Ofertas cuyo producto ya no responde en la API: basura de la migración.
const huerfanas = activas.filter((o) => !o.p).length;
---
<Admin titulo="Ofertas">
  <header class="admin-titulo">
    <div>
      <h1>Ofertas</h1>
      <p>
        Ajusta el precio rebajado en el cuadro precio de oferta. Al lado veras el monto del porcentaje rebajado. Puedes colocarle una fecha de vencimiento de la oferta en el cuadro <strong>vence</strong> o puedes dejarlo con fecha indefinida seleccionando el cuadro indefinida.
      </p>
    </div>
  </header>

  {mensaje?.ok && <p class="admin-ok" role="status">{mensaje.ok}</p>}
  {mensaje?.aviso && <p class="admin-aviso" role="status">{mensaje.aviso}</p>}
  {mensaje?.error && <p class="admin-errores" role="alert">{mensaje.error}</p>}
  {errores.length > 0 && (
    <ul class="admin-errores" role="alert">{errores.map((e) => <li>{e}</li>)}</ul>
  )}

  {!almacenListo() && (
    <div class="admin-aviso">
      <strong>Guardando solo en memoria.</strong>
      No encuentro <code>BLOB_READ_WRITE_TOKEN</code>. Los cambios se pierden al reiniciar.
    </div>
  )}

  {huerfanas > 0 && (
    <form method="POST" class="admin-aviso admin-aviso-accion">
      <div>
        <strong>Hay {huerfanas} producto{huerfanas > 1 ? 's' : ''} que ya no está{huerfanas > 1 ? 'n' : ''} en el catálogo.</strong>
        Quedaron de cuando los productos eran de ejemplo. No se ven en la tienda.
      </div>
      <button type="submit" name="accion" value="limpiar-huerfanos" class="btn btn-negro">
        Quitar {huerfanas > 1 ? 'todos' : ''}
      </button>
    </form>
  )}

  <div class="panel-buscador">
    <label for="buscar-producto">Buscar</label>
    <input type="search" id="buscar-producto" placeholder="Nombre o marca…" autocomplete="off">
    <span class="panel-cuenta">
      {activas.length - vencidas - huerfanas} activas
      {vencidas > 0 && ` · ${vencidas} vencida${vencidas > 1 ? 's' : ''}`}
      {huerfanas > 0 && ` · ${huerfanas} fuera del catálogo`}
    </span>
  </div>

  <form method="POST" class="admin-form">
    <section class="admin-seccion" data-grupo>
      {activas.length === 0 && (
        <p class="panel-sin">
          No hay ofertas cargadas. Elige productos desde <a href="/admin/categorias">Productos</a>.
        </p>
      )}

      <div class="ofertas-lista">
        {activas.map((o) => { const { codigo, precio, vence, p } = o; return (
          <div class={`oferta-fila ${o.vigente ? '' : 'vencida'}`} data-busca={p ? `${p.nombre} ${p.marca ?? ''}` : codigo}>
            <input type="hidden" name="oferta" value={codigo}>
            <span class="elegir-codigo">{codigo}</span>
            <div class="oferta-datos">
              <strong>{p?.nombre ?? 'Producto fuera del catálogo'}</strong>
              <small>
                {p
                  ? <>{[p.marca, p.categoria].filter(Boolean).join(' · ')}{p.precio ? ` · lista $${p.precio.toFixed(2)}` : ''}</>
                  : <em class="marca-vencida">ya no está en la API · quítalo</em>}
                {enTop.has(codigo) && <em class="marca-estrella">top ventas</em>}
                {p && !p.disponible && <em class="marca-vencida">agotado</em>}
                {!o.vigente && <em class="marca-vencida">vencida · no se ve en la tienda</em>}
              </small>
            </div>
            <label class="oferta-campo">
              <span>Precio de oferta</span>
              <input type="number" step="0.01" min="0.01" max={p?.precio ? p.precio - 0.01 : undefined}
                     name={`precio:${codigo}`} value={precio.toFixed(2)}
                     data-lista={p?.precio ?? ''}
                     aria-label={`Precio de oferta de ${p?.nombre ?? codigo}`}>
            </label>
            <div class="oferta-descuento" data-descuento aria-live="polite">
              <span>Descuento</span>
              <strong>—</strong>
            </div>
            <div class="oferta-campo oferta-vence">
              <span>Vence</span>
              <input type="date" name={`vence:${codigo}`} value={vence} disabled={!vence}
                     aria-label={`Vencimiento de la oferta de ${p?.nombre ?? codigo}`}>
              <label class="oferta-indef">
                <input type="checkbox" name={`indef:${codigo}`} checked={!vence} data-indefinida>
                Indefinida
              </label>
            </div>
            <MenuProducto id={codigo} acciones={[
              { valor: 'quitar-oferta', texto: 'Quitar de Ofertas', peligro: true },
              { valor: 'a-topventas', texto: 'Pasar también a Lo más vendido' },
            ]} />
          </div>
        ); })}
      </div>
    </section>

    <p class="panel-sin" id="sin-coincidencias" hidden>
      No hay productos que coincidan con “<span data-termino></span>”.
    </p>

    {activas.length > 0 && (
      <div class="admin-pie-form">
        <button type="submit" class="btn btn-amarillo">Guardar cambios</button>
      </div>
    )}
  </form>

  <script>
    import '../../scripts/panel.js';
  </script>
</Admin>
