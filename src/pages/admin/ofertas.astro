---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import MenuProducto from '../../components/MenuProducto.astro';
import { POR_ID } from '../../datos/catalogo.js';
import { leer, guardar, almacenListo, accionProducto, ofertaVigente } from '../../datos/curaduria.js';

let errores = [];
let mensaje = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = f.get('accion');

  if (accion) {
    const [que, id] = String(accion).split(':');
    mensaje = await accionProducto(que, id);
  } else {
    // Guardado en bloque de precios y vencimientos.
    const ofertas = f.getAll('oferta').map(String).map((id) => ({
      id,
      precio: Number(String(f.get(`precio:${id}`) ?? '').replace(',', '.')),
      // Indefinida se guarda como fecha vacía: es lo que ya entiende ofertaVigente().
      vence: f.get(`indef:${id}`) ? '' : String(f.get(`vence:${id}`) ?? ''),
    }));
    errores = await guardar({ ofertas });
    if (!errores.length) mensaje = { ok: 'Listo. Las ofertas quedaron publicadas.' };
  }
}

const estado = await leer();
const activas = estado.ofertas
  .map((o) => ({ ...o, p: POR_ID.get(o.id), vigente: ofertaVigente(o) }))
  .filter((o) => o.p);
const vencidas = activas.filter((o) => !o.vigente).length;
const enEstrella = new Set(estado.semana);
---
<Admin titulo="Ofertas">
  <header class="admin-titulo">
    <div>
      <h1>Ofertas</h1>
      <p>
        Ajustá el precio rebajado y hasta cuándo vale. Marcá <strong>Indefinida</strong>
        para que dure hasta que vos la saques. Al pasar la fecha, el producto
        desaparece solo de la tienda y queda acá para volver a activarlo.
        Para agregar uno, buscalo en <a href="/admin/categorias">Productos</a> y usá su menú <strong>⋯</strong>.
      </p>
    </div>
  </header>

  {mensaje?.ok && <p class="admin-ok" role="status">{mensaje.ok}</p>}
  {mensaje?.aviso && <p class="admin-aviso" role="status">{mensaje.aviso}</p>}
  {mensaje?.error && <p class="admin-errores" role="alert">{mensaje.error}</p>}
  {errores.length > 0 && (
    <ul class="admin-errores" role="alert">{errores.map((e) => <li>{e}</li>)}</ul>
  )}

  {!almacenListo() && (
    <div class="admin-aviso">
      <strong>Guardando solo en memoria.</strong>
      No encuentro <code>BLOB_READ_WRITE_TOKEN</code>. Los cambios se pierden al reiniciar.
    </div>
  )}

  <div class="panel-buscador">
    <label for="buscar-producto">Buscar</label>
    <input type="search" id="buscar-producto" placeholder="Nombre o marca…" autocomplete="off">
    <span class="panel-cuenta">{activas.length - vencidas} activas{vencidas > 0 && ` · ${vencidas} vencida${vencidas > 1 ? 's' : ''}`}</span>
  </div>

  <form method="POST" class="admin-form">
    <section class="admin-seccion" data-grupo>
      {activas.length === 0 && (
        <p class="panel-sin">
          No hay ofertas cargadas. Elegí productos desde <a href="/admin/categorias">Productos</a>.
        </p>
      )}

      <div class="ofertas-lista">
        {activas.map((o) => { const { id, precio, vence, p } = o; return (
          <div class={`oferta-fila ${o.vigente ? '' : 'vencida'}`} data-busca={`${p.n} ${p.m}`}>
            <input type="hidden" name="oferta" value={id}>
            <img src={`/assets/img/${p.img}.jpg`} alt="" loading="lazy">
            <div class="oferta-datos">
              <strong>{p.n}</strong>
              <small>
                {p.m} · lista ${p.p.toFixed(2)}
                {enEstrella.has(id) && <em class="marca-estrella">estrella</em>}
                {!o.vigente && <em class="marca-vencida">vencida · no se ve en la tienda</em>}
              </small>
            </div>
            <label class="oferta-campo">
              <span>Precio de oferta</span>
              <input type="number" step="0.01" min="0.01" max={p.p - 0.01}
                     name={`precio:${id}`} value={precio.toFixed(2)}
                     data-lista={p.p}
                     aria-label={`Precio de oferta de ${p.n}`}>
            </label>
            <div class="oferta-descuento" data-descuento aria-live="polite">
              <span>Descuento</span>
              <strong>—</strong>
            </div>
            <div class="oferta-campo oferta-vence">
              <span>Vence</span>
              <input type="date" name={`vence:${id}`} value={vence} disabled={!vence}
                     aria-label={`Vencimiento de la oferta de ${p.n}`}>
              <label class="oferta-indef">
                <input type="checkbox" name={`indef:${id}`} checked={!vence} data-indefinida>
                Indefinida
              </label>
            </div>
            <MenuProducto id={id} acciones={[
              { valor: 'quitar-oferta', texto: 'Quitar de Ofertas', peligro: true },
              { valor: 'a-estrella', texto: 'Pasar también a Productos estrella' },
            ]} />
          </div>
        ); })}
      </div>
    </section>

    <p class="panel-sin" id="sin-coincidencias" hidden>
      No hay productos que coincidan con “<span data-termino></span>”.
    </p>

    {activas.length > 0 && (
      <div class="admin-pie-form">
        <button type="submit" class="btn btn-amarillo">Guardar cambios</button>
      </div>
    )}
  </form>

  <script>
    import '../../scripts/panel.js';
  </script>
</Admin>
