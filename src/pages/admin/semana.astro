---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import MenuProducto from '../../components/MenuProducto.astro';
import { POR_ID } from '../../datos/catalogo.js';
import { leer, almacenListo, accionProducto, CUPOS_SEMANA } from '../../datos/curaduria.js';

let mensaje = null;

if (Astro.request.method === 'POST') {
  const accion = (await Astro.request.formData()).get('accion');
  const [que, id] = String(accion ?? '').split(':');
  if (que) mensaje = await accionProducto(que, id);
}

const estado = await leer();
const elegidos = estado.semana.map((id) => POR_ID.get(id)).filter(Boolean);
const enOferta = new Set(estado.ofertas.map((o) => o.id));
---
<Admin titulo="Productos estrella">
  <header class="admin-titulo">
    <div>
      <h1>Productos estrella</h1>
      <p>
        Los que salen en la rejilla de la página principal. Entran {CUPOS_SEMANA}.
        Para agregar uno, buscalo en <a href="/admin/categorias">Productos</a> y usá su menú <strong>⋯</strong>.
      </p>
    </div>
  </header>

  {mensaje?.ok && <p class="admin-ok" role="status">{mensaje.ok}</p>}
  {mensaje?.aviso && <p class="admin-aviso" role="status">{mensaje.aviso}</p>}
  {mensaje?.error && <p class="admin-errores" role="alert">{mensaje.error}</p>}

  {!almacenListo() && (
    <div class="admin-aviso">
      <strong>Guardando solo en memoria.</strong>
      No encuentro <code>BLOB_READ_WRITE_TOKEN</code>. Los cambios se pierden al reiniciar.
    </div>
  )}

  <div class="panel-buscador">
    <label for="buscar-producto">Buscar</label>
    <input type="search" id="buscar-producto" placeholder="Nombre o marca…" autocomplete="off">
    <span class="panel-cuenta">{elegidos.length} de {CUPOS_SEMANA} cupos</span>
  </div>

  <form method="POST" class="admin-form">
    <section class="admin-seccion" data-grupo>
      {elegidos.length === 0 && (
        <p class="panel-sin">
          Todavía no hay ninguno. Elegilos desde <a href="/admin/categorias">Productos</a>.
        </p>
      )}
      <div class="elegir">
        {elegidos.map((p) => (
          <div class="elegir-fila" data-busca={`${p.n} ${p.m}`}>
            <div class="elegir-item sin-casilla">
              <img src={`/assets/img/${p.img}.jpg`} alt="" loading="lazy">
              <span class="elegir-datos">
                <strong>{p.n}</strong>
                <small>
                  {p.m} · ${p.p.toFixed(2)}
                  {enOferta.has(p.id) && <em class="marca-oferta">en oferta</em>}
                </small>
              </span>
            </div>
            <MenuProducto id={p.id} acciones={[
              { valor: 'quitar-estrella', texto: 'Quitar de Productos estrella', peligro: true },
              { valor: 'a-oferta', texto: 'Poner también en oferta' },
            ]} />
          </div>
        ))}
      </div>
    </section>

    <p class="panel-sin" id="sin-coincidencias" hidden>
      No hay productos que coincidan con “<span data-termino></span>”.
    </p>
  </form>

  <script>
    import '../../scripts/panel.js';
  </script>
</Admin>
