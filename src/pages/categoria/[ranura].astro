---
/* Página de un rubro del catálogo.

   Hasta ahora los rubros se miraban en una ventana flotante que abría "Ver
   todo": cómoda, pero invisible. Sin dirección propia no hay nada que Google
   indexe, nada que pegar en un grupo de WhatsApp y nada a lo que volver con el
   botón de atrás. Esto es esa misma pantalla, pero siendo una página: el
   listado lo arma el servidor y el buscador, el filtro y el "ver más" se
   montan encima sin recargar.

   No se prerenderiza, por lo mismo que las fichas: los precios y la
   disponibilidad cambian durante el día. */
export const prerender = false;

import { resumen, productos, apiLista, ranura, urlProducto, normalizar } from '../../datos/api.js';
import { NEGOCIO, comoJSONLD } from '../../datos/negocio.js';
import { tarjetaProducto } from '../../scripts/tarjeta.js';
import Carrito from '../../components/Carrito.astro';
import '../../styles/styles.css';

const POR_PAGINA = 24;

if (!apiLista()) return new Response(null, { status: 503 });

const pedida = Astro.params.ranura;
const pagina = Math.max(Number(Astro.url.searchParams.get('pagina')) || 1, 1);

let info;
try {
  info = await resumen();
} catch {
  return new Response(null, { status: 503 });
}

/* La dirección lleva la ranura; el nombre real es el que entiende la API. */
const rubro = info.categorias.find((c) => ranura(c.nombre) === pedida);
if (!rubro) return new Response(null, { status: 404 });

let lista;
try {
  lista = await productos({
    categoria: rubro.nombre,
    limit: POR_PAGINA,
    offset: (pagina - 1) * POR_PAGINA,
  });
} catch {
  return new Response(null, { status: 502 });
}

if (!lista.productos.length && pagina > 1) return new Response(null, { status: 404 });

/* Dos minutos en la CDN. Cada visita a esta página cuesta dos peticiones a la
   API —el resumen y el listado—, y el límite es de 120 por minuto para todo el
   sitio: sin caché, sesenta visitas en un minuto nos dejarían fuera. Con esto,
   todas las de esos dos minutos cuestan una sola. */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=120, stale-while-revalidate=600',
);

const base = (Astro.site ?? new URL(Astro.url).origin).toString().replace(/\/$/, '');
const ruta = `/categoria/${pedida}`;
const canonica = `${base}${ruta}${pagina > 1 ? `?pagina=${pagina}` : ''}`;
const paginas = Math.ceil(lista.total / POR_PAGINA);

const bonito = (t) => t.charAt(0) + t.slice(1).toLowerCase();
const nombre = bonito(rubro.nombre);

const titulo = pagina > 1
  ? `${nombre} — página ${pagina} | ${NEGOCIO.nombreCorto}`
  : `${nombre} en Barcelona, Anzoátegui | ${NEGOCIO.nombreCorto}`;

const descripcion =
  `${rubro.total.toLocaleString('es-VE')} productos de ${nombre.toLowerCase()} en `
  + `${NEGOCIO.nombreCorto}, ${NEGOCIO.direccion.ciudad}. Precios en dólares, `
  + 'entrega en la zona y asesoría antes de comprar.';

/* Las tarjetas las arma el mismo módulo que las de la home. Es un template de
   texto, así que sirve igual en el servidor: acá se renderiza el primer lote y
   categoria.js usa la misma función para los que va sumando. Una sola tarjeta
   en un solo lugar — si mañana cambia, cambia en las dos pantallas. */
const tarjetas = lista.productos.map((p) => tarjetaProducto(normalizar(p))).join('');

/* Miga de pan estructurada: le dice a Google dónde encaja esta página y le
   permite mostrar la ruta en vez de la URL cruda en los resultados. */
const miga = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: base },
    { '@type': 'ListItem', position: 2, name: nombre, item: `${base}${ruta}` },
  ],
};

/* Lista de artículos: lo que Google usa para entender que esto es un listado
   de productos y no un texto cualquiera. Solo la primera página, que es la que
   se ofrece como resultado. */
const listado = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: nombre,
  numberOfItems: lista.productos.length,
  itemListElement: lista.productos.map((p, i) => ({
    '@type': 'ListItem',
    position: (pagina - 1) * POR_PAGINA + i + 1,
    url: `${base}${urlProducto(p)}`,
    name: p.nombre,
  })),
};
---
<!doctype html>
<html lang="es-VE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<link rel="canonical" href={canonica}>
{/* Las páginas 2 en adelante no aportan nada distinto a Google: se recorren
    para llegar a los productos, pero no compiten como resultado. */}
{pagina > 1 && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descripcion}>
<meta property="og:url" content={canonica}>
<meta property="og:image" content={`${base}/assets/logo.png`}>
<meta name="theme-color" content="#FFDD00">
<link rel="icon" href="/assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap">
<script type="application/ld+json" set:html={comoJSONLD(miga)} />
<script type="application/ld+json" set:html={comoJSONLD(listado)} />
</head>
<body class="pagina-producto">

<svg style="display:none" aria-hidden="true">
  <symbol id="i-herramienta" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></symbol>
  <symbol id="i-izq" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
  <symbol id="i-buscar" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></symbol>
  <symbol id="i-carrito" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></symbol>
  <symbol id="i-cerrar" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></symbol>
</svg>

<header class="producto-cabecera">
  <div class="contenedor producto-cabecera-int">
    <a href="/" class="marca">
      <img src="/assets/logo.png" alt="" class="marca-logo">
      <span class="marca-texto">
        <strong>CASA HERRAMIENTAS</strong>
        <small>{NEGOCIO.rubro}</small>
      </span>
    </a>
    <div class="cat-cabecera-acciones">
      <a class="btn btn-negro" href="/">
        <svg class="ico"><use href="#i-izq"/></svg>
        <span class="btn-volver-largo">Volver a la tienda</span>
        <span class="btn-volver-corto">Volver</span>
      </a>
      <button class="btn-icono" id="btn-carrito" aria-label="Ver el pedido" aria-controls="panel-carrito">
        <svg class="ico"><use href="#i-carrito"/></svg>
        <span class="contador" id="contador-carrito" hidden>0</span>
      </button>
    </div>
  </div>
</header>

<main class="contenedor cat-pagina">
  <nav class="miga" aria-label="Dónde estás">
    <a href="/">Inicio</a> · <span>{nombre}</span>
  </nav>

  <header class="cat-cabeza">
    <h1>{nombre}</h1>
    <p id="cat-cuenta">
      {rubro.total.toLocaleString('es-VE')} productos{paginas > 1 && ` · página ${pagina} de ${paginas}`}
    </p>
  </header>

  {/* Buscador y filtro. Van dentro de un <form> con method GET para que
      funcionen sin JavaScript: sin él la página recarga con ?q=…, y con él
      categoria.js lo intercepta y repinta la rejilla en el sitio. */}
  <form class="cat-herramientas" id="cat-herramientas" method="get" action={ruta}>
    <div class="cat-buscar">
      <svg class="ico"><use href="#i-buscar"/></svg>
      <label class="visualmente-oculto" for="cat-q">Buscar en {nombre.toLowerCase()}</label>
      <input type="search" id="cat-q" name="q" autocomplete="off"
             placeholder={`Buscar en ${nombre.toLowerCase()}…`}>
    </div>
    <label class="cat-filtro">
      <input type="checkbox" id="cat-solo-hay" name="hay" value="1">
      <span>Solo disponibles</span>
    </label>
    <button type="submit" class="btn btn-negro cat-aplicar">Buscar</button>
  </form>

  <p class="panel-sin" id="cat-vacio" hidden>No hay productos que coincidan con esa búsqueda.</p>

  {/* Las tarjetas son h3, como en la home. Este h2 escondido evita el salto de
      h1 a h3, que a un lector de pantalla le suena a que se perdió una sección. */}
  <h2 class="visualmente-oculto">Productos de {nombre.toLowerCase()}</h2>
  <div class="cat-rejilla" id="cat-rejilla" set:html={tarjetas} />

  <p class="cat-estado" id="cat-estado" hidden></p>

  {/* Con JavaScript, categoria.js cambia esto por un botón de "ver más" que va
      sumando tandas. Sin él quedan los enlaces de página, que además son los
      que recorre Google para llegar a todo el rubro. */}
  {paginas > 1 && (
    <nav class="cat-paginas" id="cat-paginas" aria-label="Páginas">
      {pagina > 1 && <a rel="prev" href={`${ruta}${pagina - 1 > 1 ? `?pagina=${pagina - 1}` : ''}`}>← Anterior</a>}
      <span>Página {pagina} de {paginas.toLocaleString('es-VE')}</span>
      {pagina < paginas && <a rel="next" href={`${ruta}?pagina=${pagina + 1}`}>Siguiente →</a>}
    </nav>
  )}
</main>

<Carrito />

<script define:vars={{ categoria: rubro.nombre, offsetInicial: (pagina - 1) * POR_PAGINA + lista.productos.length, totalRubro: lista.total }}>
  window.__categoria = { categoria, offsetInicial, totalRubro };
</script>
<script>
  import '../../scripts/categoria.js';
</script>
</body>
</html>
