---
/* Ficha de producto.

   Se renderiza en el servidor, no se prerenderiza: son 8.437 productos con
   precios que cambian durante el día. Construirlas todas en cada despliegue
   tardaría una eternidad y quedarían viejas igual.

   Esta página es la que ve Google. El panel que abre sin recargar desde la
   home es un agregado encima: si el visitante llega por un enlace, por el
   buscador o con el JavaScript apagado, esto es lo que recibe. */
export const prerender = false;

import { producto, apiLista, ranura, urlProducto } from '../../datos/api.js';
import { consultarAgotado, consultarProducto } from '../../scripts/whatsapp.js';
import { comoJSONLD } from '../../datos/negocio.js';
import Carrito from '../../components/Carrito.astro';
import '../../styles/styles.css';

/* La dirección es /producto/nombre-del-producto/CODIGO, pero también entra
   /producto/CODIGO a secas: el código es siempre el último tramo. Eso mantiene
   vivos los enlaces viejos y los que alguien escriba a mano. */
const tramos = (Astro.params.ruta ?? '').split('/').filter(Boolean);
const codigo = tramos.at(-1);

if (!codigo) return new Response(null, { status: 404 });

const p = apiLista() ? await producto(codigo).catch(() => null) : null;

if (!p) return new Response(null, { status: 404, statusText: 'Producto no encontrado' });

/* Si el nombre en la dirección no es el que corresponde —porque el producto se
   renombró, o porque llegaron solo con el código— se redirige al canónico con
   un 301. Sin esto Google vería el mismo producto en varias direcciones y
   repartiría el posicionamiento entre todas. */
const canonicaRelativa = urlProducto(p);
if (`/producto/${tramos.join('/')}` !== canonicaRelativa) {
  return Astro.redirect(canonicaRelativa, 301);
}

/* Dos minutos en la CDN, igual que el resto del catálogo: el precio puede
   moverse durante el día, pero una ficha sin caché es una petición a la API
   por visita, y el límite es de 120 por minuto para todo el sitio. */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=120, stale-while-revalidate=600',
);

const precio = (n) =>
  '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.').replace(/\.(\d{2})$/, ',$1');

const vendible = p.disponible && p.precio > 0;
const canonica = new URL(canonicaRelativa, Astro.site ?? Astro.url.origin).href;

/* A dónde vuelve el botón de la cabecera: al rubro del producto, no a la home.
   Se llega a una ficha desde la página del rubro, y mandar de vuelta al inicio
   obligaba a rehacer todo el camino. Para ir al inicio está el logo.

   Sale de `p.categoria` y no de cómo se haya llegado: así vale igual para
   quien entra desde Google o desde un enlace pegado en WhatsApp. Si el
   producto no trae categoría —no debería, pero la API manda— queda la home. */
const bonito = (t) => t.charAt(0) + t.slice(1).toLowerCase();
const volver = p.categoria
  ? { url: `/categoria/${ranura(p.categoria)}`, nombre: bonito(p.categoria) }
  : { url: '/', nombre: 'la tienda' };

/* Un producto agotado o sin precio se muestra, porque alguien puede llegar por
   un enlace viejo, pero no se ofrece a Google: son páginas sin nada que
   ofrecer, y publicar miles así arrastra al resto del sitio. */
const indexable = vendible;

const ficha = [
  p.marca && ['Marca', p.marca],
  ['Código', p.codigo],
  p.categoria && ['Categoría', p.categoria],
  ...Object.entries(p.atributos ?? {}).map(([k, v]) => [k[0].toUpperCase() + k.slice(1), v]),
].filter(Boolean);

const descripcion = [
  p.nombre,
  p.marca ? `Marca ${p.marca}.` : '',
  vendible ? `${precio(p.precio)}.` : '',
  'Casa Herramientas, Barcelona, estado Anzoátegui.',
].filter(Boolean).join(' ');

/* Dato estructurado. Se declara solo lo que la API garantiza: inventar una
   valoración o un stock que no tenemos sería mentirle a Google, y las fichas
   de producto son de lo que más vigila. */
const datosProducto = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.nombre,
  sku: p.codigo,
  ...(p.marca ? { brand: { '@type': 'Brand', name: p.marca } } : {}),
  ...(p.categoria ? { category: p.categoria } : {}),
  ...(p.imagenes?.length ? { image: p.imagenes.map((i) => i.url) } : {}),
  offers: {
    '@type': 'Offer',
    url: canonica,
    priceCurrency: 'USD',
    ...(p.precio > 0 ? { price: p.precio } : {}),
    availability: vendible
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Store', name: 'Casa Herramientas, C.A.' },
  },
};
---
<!doctype html>
<html lang="es-VE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{p.nombre} — Casa Herramientas</title>
<meta name="description" content={descripcion}>
<link rel="canonical" href={canonica}>
{!indexable && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="product">
<meta property="og:title" content={p.nombre}>
<meta property="og:description" content={descripcion}>
<meta property="og:url" content={canonica}>
{p.imagenes?.[0]?.url && <meta property="og:image" content={p.imagenes[0].url} />}
<meta name="theme-color" content="#FFDD00">
<link rel="icon" href="/assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap">
<script type="application/ld+json" set:html={comoJSONLD(datosProducto)} />
</head>
<body class="pagina-producto">

<svg style="display:none" aria-hidden="true">
  <symbol id="i-carrito" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></symbol>
  <symbol id="i-herramienta" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></symbol>
  <symbol id="i-izq" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></symbol>
  <symbol id="i-cerrar" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="m20 6-11 11-5-5"/></symbol>
</svg>

<header class="producto-cabecera">
  <div class="contenedor producto-cabecera-int">
    <a href="/" class="marca">
      <img src="/assets/logo.png" alt="" class="marca-logo">
      <span class="marca-texto">
        <strong>CASA HERRAMIENTAS</strong>
        <small>Ferretería y Construcción C.H</small>
      </span>
    </a>
    <div class="cat-cabecera-acciones">
      <a class="btn btn-negro volver-rubro" href={volver.url} aria-label={`Volver a ${volver.nombre}`}>
        <svg class="ico"><use href="#i-izq"/></svg>
        <span class="btn-volver-largo">Volver a {volver.nombre}</span>
        <span class="btn-volver-corto">Volver</span>
      </a>
      <button class="btn-icono" id="btn-carrito" aria-label="Ver el pedido" aria-controls="panel-carrito">
        <svg class="ico"><use href="#i-carrito"/></svg>
        <span class="contador" id="contador-carrito" hidden>0</span>
      </button>
    </div>
  </div>
</header>

<main class="contenedor ficha">
  <nav class="miga" aria-label="Dónde estás">
    <a href="/">Inicio</a>
    {p.categoria && <> · <a href={`/categoria/${ranura(p.categoria)}`}>{p.categoria}</a></>}
  </nav>

  <div class="ficha-int">
    <div class={`ficha-foto${p.imagenes?.length ? '' : ' vacia'}`}>
      {p.imagenes?.[0]?.url
        ? <img src={p.imagenes[0].url} alt={p.nombre} />
        : <span class="producto-sinfoto" aria-hidden="true"><svg class="ico"><use href="#i-herramienta"/></svg></span>}
    </div>

    <div class="ficha-datos">
      {p.marca && <span class="ficha-marca">{p.marca}</span>}
      <h1>{p.nombre}</h1>

      <p class="ficha-precio">
        {p.precio > 0 ? precio(p.precio) : 'Precio a consultar'}
        {p.precio > 0 && <small>IVA incluido</small>}
      </p>

      <p class={`ficha-estado ${vendible ? 'hay' : 'no-hay'}`}>
        {vendible ? 'Disponible en tienda' : 'Sin existencia por ahora'}
      </p>

      {vendible ? (
        <button class="btn btn-amarillo btn-ancho" data-agregar
                data-id={p.codigo} data-nombre={p.nombre}
                data-marca={p.marca ?? ''} data-precio={p.precio}>
          <svg class="ico"><use href="#i-carrito"/></svg> Agregar al pedido
        </button>
      ) : (
        <a class="btn btn-negro btn-ancho" target="_blank" rel="noopener"
           href={consultarAgotado({ nombre: p.nombre, marca: p.marca, codigo: p.codigo })}>
          <svg class="ico"><use href="#i-chat"/></svg> Consultar disponibilidad
        </a>
      )}

      <table class="ficha-tabla">
        <tbody>
          {ficha.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>

    </div>
  </div>
</main>

<Carrito />

<script>
  import '../../scripts/ficha.js';
</script>
</body>
</html>
